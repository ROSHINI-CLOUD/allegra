{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/.next",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api"
    }
  ]
}
