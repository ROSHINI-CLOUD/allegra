PORT=8080
NODE_ENV=development
APP_VERSION=0.1.0
ALLEGRA_ORIGIN=http://127.0.0.1:5173

# Provider endpoints. Development falls back to public community deployments when
# these are blank; production requires SAAVN_API_URL to be set explicitly.
SAAVN_API_URL=https://jiosaavn-api-byprats.vercel.app/api
SAAVN_SECONDARY_API_URL=
GAANA_API_URL=https://gaanaapibyprats.vercel.app/api
LRCLIB_API_URL=https://lrclib.net/api
# Lyrics fallbacks, tried in order when LRCLIB has nothing. Blank = built-in default; `off` disables.
LYRICA_API_URL=
# Better Lyrics (word-synced TTML). Works for songs it already has cached; add a key for
# uncached lookups (request one from the Better Lyrics API project).
BETTERLYRICS_API_URL=
BETTERLYRICS_API_KEY=

# Karaoke vocal removal (Scarleta). Blank disables GET/POST /api/songs/:id/karaoke
# (503) and leaves the rest of the API unaffected. Free keys use the sk_free_* prefix.
# Never put this in VITE_* — browser must never call Scarleta.
SCARLETA_API_KEY=
SCARLETA_API_BASE_URL=https://api.scarleta.ai

JWT_SECRET=replace-with-a-local-development-secret

# Persistence. Leave both blank to keep guest data in memory (lost on restart).
# To persist with Convex: run `npx convex dev`, then set the same secret in the
# Convex dashboard (Settings -> Environment Variables) as CONVEX_SERVER_SECRET.
CONVEX_URL=
CONVEX_SERVER_SECRET=

# AI (taste-based recommendations, lyric translation). Cascade order: Gemini ->
# OpenRouter -> NVIDIA -> Groq -> Bedrock. Leave all blank to disable both
# features — the API answers 503 on the two /api/ai/* routes and everything
# else is unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NVIDIA NIM (integrate.api.nvidia.com) — OpenAI-compatible, same client as OpenRouter/Groq.
# Default is a model this account can call; many listed NIM ids 404 per-key.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Bedrock — last in the cascade by default, first when AI_PRIMARY=bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when using temporary creds from `aws login` (keys starting with ASIA).
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Moves one provider to the front of the cascade; everything else keeps its
# usual order behind it. Set to `bedrock` in production so recommendations and
# lyric translation run on AWS. A name with no key configured is ignored.
AI_PRIMARY=

# Custom playlist covers (S3 + CloudFront). Leave blank to disable
# POST /api/uploads/sign (returns 503). Uses the same AWS keys as Bedrock.
# Public base is the CloudFront distribution URL (preferred) or the bucket's
# public HTTPS origin — never include a trailing slash.
S3_COVERS_BUCKET=
S3_COVERS_PUBLIC_BASE_URL=
S3_COVERS_REGION=
S3_COVERS_UPLOAD_EXPIRES_SECONDS=120

# DynamoDB TTL cache (optional). When set, the API layers in-process memory on
# top of this table so search/lyrics/AI hits survive App Runner restarts.
# Leave blank for memory-only (fine for local). App Runner sets this from CFN.
# Creds: same AWS_* keys as Bedrock, or the container instance role.
DDB_TABLE_CACHE=
