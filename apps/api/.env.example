PORT=8080
NODE_ENV=development
APP_VERSION=0.1.0
ALLEGRA_ORIGIN=http://127.0.0.1:5173

# Web app (apps/web/.env.local). NEXT_PUBLIC_* is inlined into the public bundle,
# so only ever put non-secret values there.
#   NEXT_PUBLIC_API_BASE_URL=       (blank = same-origin /api — correct everywhere)
#   NEXT_PUBLIC_CONVEX_URL=         (https://<name>.convex.cloud — enables Google sign-in)

# Provider endpoints. Development falls back to public community deployments when
# these are blank; production requires SAAVN_API_URL to be set explicitly.
SAAVN_API_URL=https://jiosaavn-api-byprats.vercel.app/api
SAAVN_SECONDARY_API_URL=
GAANA_API_URL=https://gaanaapibyprats.vercel.app/api
LRCLIB_API_URL=https://lrclib.net/api
# Lyrics fallbacks, tried in order when LRCLIB has nothing. Blank = built-in default; `off` disables.
LYRICA_API_URL=
# Better Lyrics (word-synced TTML). Works for songs it already has cached; add a key for
# uncached lookups (request one from the Better Lyrics API project).
BETTERLYRICS_API_URL=
BETTERLYRICS_API_KEY=

# Signs guest (anonymous) session tokens only. Real accounts are signed by Convex.
JWT_SECRET=replace-with-a-local-development-secret

# Persistence. Leave both blank to keep guest data in memory (lost on restart).
# To persist with Convex: run `npx convex dev`, then set the same secret in the
# Convex dashboard (Settings -> Environment Variables) as CONVEX_SERVER_SECRET.
CONVEX_URL=
CONVEX_SERVER_SECRET=
# Where Convex Auth session tokens come from. Derived from CONVEX_URL
# (.convex.cloud -> .convex.site) unless set. Unset = guest sessions only.
CONVEX_SITE_URL=

# Google sign-in is configured in the CONVEX deployment, not here, so this API
# never holds a Google secret. In the Convex dashboard set:
#   AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
# and add <site>/api/auth/callback/google as an authorised redirect URI in Google
# Cloud Console. See docs/auth-convex-google.md.

# Lyrics translation runs on MyMemory (machine translation, no key, no LLM).
# Anonymous use is capped at 5,000 characters a day; a contact address raises it to
# 50,000. Server-side only. MYMEMORY_API_URL is only for tests or a mirror.
# For a durable free fallback, self-host LibreTranslate and set its origin below.
# Do not point this at a random public mirror: availability and data handling are not guaranteed.
TRANSLATION_CONTACT_EMAIL=
MYMEMORY_API_URL=
LIBRETRANSLATE_API_URL=

# Playlist covers are stored in Convex file storage (needs CONVEX_URL above);
# without Convex, cover uploads answer 503. Recommendations come from the catalog
# and the listener's taste. There is no AWS configuration any more.
