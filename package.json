{
  "name": "allegra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mock": "node mocks/server.mjs",
    "contract-test": "node tests/contract/contract-smoke.mjs",
    "infra:test": "node --test tests/infra/infra-files.test.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm run infra:test",
    "build": "npm run build --workspaces --if-present",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.46.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
